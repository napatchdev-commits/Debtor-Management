# Environment Configuration Example
# Copy this file to .env and fill in your database details

PORT=3001
JWT_SECRET=debt_management_system_super_secret_key_2026

# OPTION A: Google Sheets 100% Database Engine (Recommended if using Google Sheets)
# Paste your Apps Script Web App URL from Google Sheets -> Extensions -> Apps Script -> Deploy as Web App
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_WEBAPP_ID/exec

# OPTION B: Supabase Credentials (Optional alternative)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
